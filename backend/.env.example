APP_NAME=AI Content Automation Workflow
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TASK_STORE_BACKEND=memory

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=ai_content_automation
MYSQL_POOL_SIZE=10
MYSQL_ECHO=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_USE_SSL=false

QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_default

STORAGE_PROVIDER=minio
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-content-assets
MINIO_USE_SSL=false

AUTH_JWT_SECRET=change_me_to_a_long_random_secret
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_TTL_SECONDS=7200
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_SESSION_TTL_SECONDS=604800
AUTH_BOOTSTRAP_PASSWORD=123456
AUTH_PASSWORD_PEPPER=local_dev_pepper
AUTH_VERIFICATION_CACHE_BACKEND=memory
AUTH_VERIFICATION_CODE_LENGTH=6
AUTH_VERIFICATION_CODE_TTL_SECONDS=300
AUTH_VERIFICATION_MAX_ATTEMPTS=5
AUTH_VERIFICATION_MOCK_FIXED_CODE=123456
AUTH_VERIFICATION_RESEND_INTERVAL_SECONDS=60

EMAIL_PROVIDER=mock
EMAIL_FROM_EMAIL=noreply@example.com
EMAIL_FROM_NAME=AI Content Automation
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false

SMS_PROVIDER=mock
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_ENDPOINT=dypnsapi.aliyuncs.com

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WEBHOOK=

CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=false

LOG_LEVEL=INFO
LOG_JSON=false

MEDIACRAWLER_ENABLED=true
MEDIACRAWLER_UV_BIN=uv
MEDIACRAWLER_ROOT_DIR=./MediaCrawlerPro
MEDIACRAWLER_PYTHON_DIR=./MediaCrawlerPro/MediaCrawlerPro-Python
MEDIACRAWLER_SIGNSRV_DIR=./MediaCrawlerPro/MediaCrawlerPro-SignSrv
MEDIACRAWLER_SIGNSRV_AUTOSTART=true
MEDIACRAWLER_SIGNSRV_STRICT_STARTUP=true
MEDIACRAWLER_SIGNSRV_HOST=127.0.0.1
MEDIACRAWLER_SIGNSRV_PORT=8989
MEDIACRAWLER_SIGNSRV_BIND_ADDRESS=127.0.0.1
MEDIACRAWLER_SIGNSRV_SIGN_TYPE=javascript
MEDIACRAWLER_SIGNSRV_PLAYWRIGHT_HEADLESS=true
MEDIACRAWLER_SIGNSRV_STARTUP_TIMEOUT_SECONDS=90
MEDIACRAWLER_RUN_TIMEOUT_SECONDS=1800
MEDIACRAWLER_DEFAULT_ACCOUNT_POOL_SAVE_TYPE=mysql
MEDIACRAWLER_DEFAULT_COOKIE_BRIDGE_URL=http://127.0.0.1:8274
MEDIACRAWLER_DEFAULT_DB_TYPE=mysql
MEDIACRAWLER_DEFAULT_SAVE_DATA_OPTION=db
MEDIACRAWLER_DEFAULT_ENABLE_IP_PROXY=false
MEDIACRAWLER_DEFAULT_CHECKPOINT_STORAGE_TYPE=file
